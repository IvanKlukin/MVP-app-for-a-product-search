<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Holo.Light.DarkActionBar">

        <!-- Главный экран: выбор роли (единственная точка входа launcher) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Экран оператора: схема и метки разделов -->
        <activity
            android:name=".ui.OperatorActivity"
            android:exported="false"
            android:label="@string/title_operator" />

        <!-- Экран оператора: пакетный импорт товаров -->
        <activity
            android:name=".ui.ProductImportActivity"
            android:exported="false"
            android:label="@string/title_import"
            android:windowSoftInputMode="adjustResize" />

        <!-- Экран покупателя: поиск товаров и подсветка метки -->
        <activity
            android:name=".ui.SearchActivity"
            android:exported="false"
            android:label="@string/title_search"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Экран покупателя: разбор списка покупок из буфера -->
        <activity
            android:name=".ui.ShoppingListActivity"
            android:exported="false"
            android:label="@string/title_shopping_list"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
