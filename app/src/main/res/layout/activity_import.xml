<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvImportDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/import_format_desc"
            android:background="@color/card_bg"
            android:padding="10dp"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnChooseFile"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/btn_choose_file"
                android:textSize="12sp"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnPasteExample"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/btn_paste_manual"
                android:textSize="12sp"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etImportText"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:background="@color/card_bg"
            android:padding="10dp"
            android:hint="@string/hint_import_text"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnRunImport"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/btn_run_import"
            android:textSize="15sp"
            android:layout_marginBottom="12dp" />

        <!-- Блок статистики и ошибок -->
        <TextView
            android:id="@+id/tvImportStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/status_found"
            android:visibility="gone"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvImportErrors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="@color/status_not_found"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
