<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Верхняя панель ввода списка покупок -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/card_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_shopping_list"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etShoppingListInput"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:textSize="14sp"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="8dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPasteClipboard"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/btn_paste_clipboard"
                android:textSize="12sp"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btnProcessList"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/btn_process_shopping_list"
                android:textSize="12sp"
                android:layout_marginLeft="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Строка сводки результатов -->
    <TextView
        android:id="@+id/tvShoppingSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="#ECEFF1"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:visibility="gone" />

    <!-- Список сопоставленных позиций -->
    <ListView
        android:id="@+id/lvShoppingResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/divider"
        android:dividerHeight="1dp" />

</LinearLayout>
